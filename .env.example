# Copy to .env and replace each placeholder. Never commit .env.
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
DB_USERNAME=bugtracker
DB_PASSWORD=replace-with-a-unique-app-database-password
DB_URL='jdbc:mysql://localhost:3306/bugtracker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'

# Optional locally. In development an unset secret is generated temporarily.
# In production set APP_ENV=production and supply a unique 32+ byte secret.
APP_ENV=development
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap one administrator when there is no active ADMIN in the database.
# Remove these entries after the admin account is created.
BOOTSTRAP_ADMIN_NAME=Your Name
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
